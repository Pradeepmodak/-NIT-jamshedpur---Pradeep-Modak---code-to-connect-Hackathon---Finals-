# SentinelRisk Environment Configuration
# Copy this file to .env and fill in your values.

# NewsAPI key (https://newsapi.org/register)
# Leave empty to use cached/sample data.
NEWSAPI_KEY=

# Set to 1 to force offline mode (cached/sample data everywhere)
DEMO_MODE=1

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Optional: Hugging Face token for gated models
# HF_TOKEN=
